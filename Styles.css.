
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap');

:root {
  --purple: #7462d5;
  --purple-dark: #5b49bb;
  --background: #f6f5fc;
  --white: #ffffff;
  --ink: #302f3d;
  --muted: #878694;
  --line: #eae8f2;
  --peach: #ffede1;
  --radius: 20px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
}

button, input, textarea, select {
  font: inherit;
}

button {
  background: var(--purple);
  color: white;
  border: 0;
  padding: 13px 21px;
  border-radius: 13px;
  font-weight: 800;
  cursor: pointer;
  transition: .2s;
  margin: 8px 5px 8px 0;
}

button:hover {
  background: var(--purple-dark);
  transform: translateY(-2px);
}

.app {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 245px;
  background: #fff;
  border-right: 1px solid var(--line);
  padding: 30px 20px;
  position: fixed;
  inset: 0 auto 0 0;
}

.sidebar h2 {
  font-family: Nunito, sans-serif;
  color: var(--purple);
  font-size: 25px;
  margin-bottom: 0;
}

.sidebar p {
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--muted);
  font-weight: 800;
  margin-top: 3px;
}

.sidebar nav {
  display: grid;
  gap: 10px;
  margin-top: 45px;
}

.sidebar nav a {
  color: var(--ink);
  text-decoration: none;
  padding: 14px;
  border-radius: 12px;
  font-weight: 700;
}

.sidebar nav a:hover,
.sidebar nav a.active {
  background: #f0edff;
  color: var(--purple);
}

.main-content {
  margin-left: 245px;
  padding: 42px;
  width: calc(100% - 245px);
  max-width: 1500px;
}

h1, h2, h3 {
  font-family: Nunito, sans-serif;
}

h1 {
  font-size: clamp(27px, 4vw, 38px);
  margin-top: 0;
}

p {
  color: var(--muted);
  line-height: 1.7;
}

.page {
  display: none;
  animation: appear .3s ease;
}

.page.active {
  display: block;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero {
  margin: 30px 0;
  padding: 55px 30px;
  text-align: center;
  border-radius: 28px;
  background: linear-gradient(135deg, #e8e2ff, #ffe9df);
  overflow: hidden;
}

.hero h2 {
  font-size: 32px;
}

.hero-characters {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin: 15px 0;
}

.hero-characters span {
  font-size: clamp(55px, 9vw, 90px);
  background: white;
  border-radius: 25px;
  padding: 12px;
  box-shadow: 0 8px 25px #5b49bb15;
}

.character-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
}

.character-card,
.project-card {
  background: var(--white);
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  text-align: center;
  box-shadow: 0 8px 25px #302f3d08;
}

.character-emoji {
  font-size: 65px;
}

label {
  display: block;
  margin: 15px 0 8px;
  font-weight: 700;
}

textarea,
input:not([type="checkbox"]),
select {
  display: block;
  width: 100%;
  max-width: 700px;
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 15px;
  background: white;
  color: var(--ink);
  outline: none;
  margin: 8px 0 20px;
}

textarea {
  min-height: 130px;
  resize: vertical;
}

textarea:focus,
input:focus,
select:focus {
  border-color: var(--purple);
  box-shadow: 0 0 0 3px #7462d51a;
}

input[type="checkbox"] {
  accent-color: var(--purple);
  width: 17px;
  height: 17px;
}

.story-output {
  display: none;
  white-space: pre-wrap;
  background: white;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 25px;
  margin: 25px 0;
  line-height: 1.8;
}

.story-output.active {
  display: block;
}

.project-card {
  text-align: left;
  margin: 15px 0;
}

.project-card button {
  font-size: 12px;
  padding: 9px 13px;
}

small {
  color: var(--muted);
}

@media (max-width: 800px) {
  .sidebar {
    position: relative;
    width: 100%;
    padding: 14px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .app {
    display: block;
  }

  .sidebar nav {
    display: flex;
    overflow-x: auto;
    gap: 5px;
    margin-top: 15px;
  }

  .sidebar nav a {
    white-space: nowrap;
    padding: 10px;
    font-size: 13px;
  }

  .main-content {
    width: 100%;
    margin: 0;
    padding: 22px 16px;
  }

  .hero {
    padding: 35px 15px;
  }

  .hero-characters {
    gap: 8px;
  }
}
